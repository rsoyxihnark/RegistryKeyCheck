<Window x:Class="RegistryKey_Check.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        x:Name="DetailWin"
        Title="Detail" Height="640" Width="880" MinHeight="420" MinWidth="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Loaded="DetailWin_Loaded" PreviewKeyDown="DetailWin_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Background="#2694A3B8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GrayBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="TextStatus" FontWeight="SemiBold" FontSize="12" Foreground="#FFCBD5E1" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TextTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrightTextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="TextBoxCommand" Style="{StaticResource ReadOnlyField}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#FFA5B4FC" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxRegCommandId" Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="1" Text="List ID" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListId" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="2" Text="List Command" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListCommand" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="3" Text="Path" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListPath" Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="4" Text="SubKey Available?" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxAvailableSubKey" Grid.Row="4" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="5" Text="List Value Name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListValueName" Grid.Row="5" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="6" Text="Value Name Available? " Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxAvailableValueName" Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="7" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="7" Text="List Value Type" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListValueType" Grid.Row="7" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="8" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="8" Text="RegEdit Value Type" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxRegEditValueType" Grid.Row="8" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="9" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="9" Text="List Value Data" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListValueData" Grid.Row="9" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="10" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="10" Text="RegEdit Value Data" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxRegEditValueData" Grid.Row="10" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <Border Grid.Row="11" Grid.ColumnSpan="2" BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="0,0,0,1" />
                    <TextBlock Grid.Row="11" Text="Execute Result" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxExecuteResult" Grid.Row="11" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                    <TextBlock Grid.Row="12" Text="List Match with RegEdit" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TextBoxListMatchWithRegEdit" Grid.Row="12" Grid.Column="1" Style="{StaticResource ReadOnlyField}" Margin="0,9" />
                </Grid>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8A7;" Content="Jump to RegEdit" Click="ButtonJumpToRegEdit_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8C8;" Content="Copy reg command" Click="ButtonCopyCommand_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="Close" Width="110" Margin="4,0,0,0" Click="ButtonClose_Click" ToolTip="Close (Esc)" />
        </StackPanel>
    </Grid>
</Window>

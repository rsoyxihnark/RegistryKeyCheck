<Window x:Class="RegistryKey_Check.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        x:Name="DetailWin"
        Title="Detail" SizeToContent="WidthAndHeight" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Loaded="DetailWin_Loaded" PreviewKeyDown="DetailWin_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Width" Value="160" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="5,6,14,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Band" TargetType="Border">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Background" Value="{StaticResource AlternateBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Width" Value="660" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Margin" Value="0,6,8,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Band}" Grid.Row="1" />
            <Border Style="{StaticResource Band}" Grid.Row="3" />
            <Border Style="{StaticResource Band}" Grid.Row="5" />
            <Border Style="{StaticResource Band}" Grid.Row="7" />
            <Border Style="{StaticResource Band}" Grid.Row="9" />
            <Border Style="{StaticResource Band}" Grid.Row="11" />
            <Label Content="UID" Grid.Row="0" />
            <Label Content="List Command" Grid.Row="1" />
            <Label Content="Path" Grid.Row="2" />
            <Label Content="SubKey Available?" Grid.Row="3" />
            <Label Content="Value" Grid.Row="4" />
            <Label Content="Value Name Available?" Grid.Row="5" />
            <Label Content="List Value Type" Grid.Row="6" />
            <Label Content="Registry Value Type" Grid.Row="7" />
            <Label Content="Expected" Grid.Row="8" />
            <Label Content="Actual" Grid.Row="9" />
            <Label Content="Execute Result" Grid.Row="10" />
            <Label Content="List Match with Registry" Grid.Row="11" />
            <Label Content="Details" Grid.Row="12" />
            <TextBox x:Name="TextBoxUID" Grid.Row="0" />
            <TextBox x:Name="TextBoxListCommand" Grid.Row="1" />
            <TextBox x:Name="TextBoxListFullPath" Grid.Row="2" />
            <TextBox x:Name="TextBoxAvailableSubKey" Grid.Row="3" />
            <TextBox x:Name="TextBoxListValueName" Grid.Row="4" />
            <TextBox x:Name="TextBoxAvailableValueName" Grid.Row="5" />
            <TextBox x:Name="TextBoxListValueType" Grid.Row="6" />
            <TextBox x:Name="TextBoxRegEditValueType" Grid.Row="7" />
            <TextBox x:Name="TextBoxListValueData" Grid.Row="8" />
            <TextBox x:Name="TextBoxRegEditValueData" Grid.Row="9" />
            <TextBox x:Name="TextBoxExecuteResult" Grid.Row="10" />
            <TextBox x:Name="TextBoxListMatchWithRegEdit" Grid.Row="11" />
            <TextBox x:Name="TextBoxComplianceDetails" Grid.Row="12" />
        </Grid>
    </ScrollViewer>
</Window>

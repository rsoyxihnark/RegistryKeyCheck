<Window x:Class="RegistryKey_Check.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        Title="Warning!" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="20" Background="#33FB923C">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#FFFB923C" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Execute the reg commands?" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrightTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="TextScope" Margin="2,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
        <Border Margin="0,14,0,0" Background="#1AF87171" BorderBrush="#40F87171" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Dikkat! Bu işlem bilgisayarınızı çalışmaz hale getirebilir." Foreground="#FFFCA5A5" TextWrapping="Wrap" />
                <TextBlock Text="Devam etmek istediğinizden emin misiniz?" Foreground="#FFFCA5A5" TextWrapping="Wrap" />
                <TextBlock Text="Attention!, This action may render your computer inoperable." Foreground="#FFFCA5A5" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="Are you sure you want to continue?" Foreground="#FFFCA5A5" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Cancel" Width="110" IsCancel="True" />
            <Button Style="{StaticResource DangerButton}" Tag="&#xE768;" Content="Execute" Width="130" Margin="4,0,0,0" Click="ButtonExecute_Click" />
        </StackPanel>
    </StackPanel>
</Window>

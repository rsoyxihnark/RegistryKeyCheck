<Window x:Class="RegistryKey_Check.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        Title="RegistryKey Check" MinHeight="700" MinWidth="1300" Background="{StaticResource WindowBrush}" FocusManager.FocusedElement="{Binding ElementName=DataGridRegCommands}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" CanExecute="Find_CanExecute" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Window.Resources>
        <local:BlankNullConverter x:Key="BlankNull" />
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem x:Name="TabItemRegCommands" Header="RegistryKey Commands">
                <Grid PreviewMouseLeftButtonDown="RegCommandsGrid_PreviewMouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PanelFind" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                        <Label Content="Find" VerticalAlignment="Center" />
                        <TextBox x:Name="TextBoxFind" Width="320" Height="24" VerticalContentAlignment="Center" TextChanged="TextBoxFind_TextChanged" PreviewKeyDown="TextBoxFind_PreviewKeyDown" />
                    </StackPanel>
                    <DataGrid x:Name="DataGridRegCommands" RowHeaderWidth="0" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Jump to RegEdit" Click="MenuJumpToRegEdit_Click" />
                                <Separator />
                                <MenuItem Header="Add to Ignore List" Click="MenuAddToIgnoreList_Click" />
                                <MenuItem Header="Remove from Ignore List" Click="MenuRemoveFromIgnoreList_Click" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRegCommands_Row_MouseDoubleClick" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRegCommands_Row_PreviewMouseRightButtonDown" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="dgColumnRegUID" Header="UID" Width="40" Binding="{Binding ListId}" />
                            <DataGridTextColumn x:Name="dgColumnRegListCommand" Header="List Command" Width="95" Visibility="Collapsed" Binding="{Binding ListCommand}" />
                            <DataGridTextColumn x:Name="dgColumnRegFullPath" Header="Path" Width="315*" Binding="{Binding ListFullPath, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableSubKey" Header="SubKey Available?" Width="115" Visibility="Collapsed" Binding="{Binding AvailableSubKey}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueName" Header="Value" Width="130*" Binding="{Binding ListValueName, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableValueName" Header="Value Name Available?" Width="140" Visibility="Collapsed" Binding="{Binding AvailableValueName, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueType" Header="List Value Type" Width="100" Visibility="Collapsed" Binding="{Binding ListValueType, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueType" Header="Registry Value Type" Width="125" Visibility="Collapsed" Binding="{Binding RegEditValueType, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueData" Header="Expected" Width="125*" Binding="{Binding ListValueData, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueData" Header="Actual" Width="125*" Binding="{Binding RegEditValueData, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegExecuteResult" Header="Execute Result" Width="95" Visibility="Collapsed" Binding="{Binding ExecuteResult}" />
                            <DataGridTextColumn x:Name="dgColumnRegListMatchWithRegEdit" Header="List Match with Registry" Width="150" Visibility="Collapsed" Binding="{Binding ListMatchWithRegEdit}" />
                            <DataGridTextColumn x:Name="dgColumnRegComplianceDetails" Header="Details" Width="210*" Binding="{Binding ComplianceDetails, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding ListMatchWithRegEdit}">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="False" Binding="{Binding ListMatchWithRegEdit}">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True" Binding="{Binding HasListWarning}">
                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="ButtonReadListFile" Grid.Row="2" Content="Read List.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,10,0" VerticalAlignment="Top" Width="160" Click="ButtonReadListFile_Click" />
                    <Button x:Name="ButtonQueryFromRegEdit" Grid.Row="2" Content="Query Registry" HorizontalAlignment="Right" Height="40" Margin="0,10,180,0" VerticalAlignment="Top" Width="160" Click="ButtonQueryFromRegEdit_Click" />
                    <Button x:Name="ButtonExecuteMissingCommands" Background="#FFFFA500" Foreground="#FF1B1F2B" Grid.Row="2" Content="Execute Missing Commands" HorizontalAlignment="Right" Height="40" Margin="0,10,350,0" VerticalAlignment="Top" Width="160" Click="ButtonExecuteMissingCommands_Click" />
                    <Button x:Name="ButtonOpenListFile" Grid.Row="2" Content="Open List.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,520,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenListFile_Click" />
                    <Button x:Name="ButtonOpenLogFile" Grid.Row="2" Content="Open Log.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,690,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenLogFile_Click" />
                    <ToggleButton x:Name="ButtonFilterFalses" Style="{StaticResource FilterToggle}" Tag="{StaticResource RedBrush}" VerticalContentAlignment="Top" Grid.Row="2" Content="Non-Compliant" HorizontalAlignment="Right" Height="21" Margin="0,8,860,0" VerticalAlignment="Top" Width="100" Click="ButtonFilterFalses_Click" />
                    <ToggleButton x:Name="ButtonFilterTrues" Style="{StaticResource FilterToggle}" Tag="{StaticResource GreenBrush}" VerticalContentAlignment="Top" Grid.Row="2" Content="Compliant" HorizontalAlignment="Right" Height="21" Margin="0,30,860,0" VerticalAlignment="Top" Width="100" Click="ButtonFilterTrues_Click" />
                    <Button x:Name="ButtonAllFiltersReset" VerticalContentAlignment="Top" Grid.Row="2" Content="All Filters Reset" HorizontalAlignment="Right" Height="21" Margin="0,8,970,0" VerticalAlignment="Top" Width="100" Click="ButtonAllFiltersReset_Click" />
                    <Button x:Name="ButtonColumns" VerticalContentAlignment="Top" Grid.Row="2" Content="Columns" HorizontalAlignment="Right" Height="21" Margin="0,8,1080,0" VerticalAlignment="Top" Width="100" Click="ButtonColumns_Click" />
                    <Button x:Name="ButtonOpenIgnoreFile" VerticalContentAlignment="Top" Grid.Row="2" Content="Open Ignore.txt" HorizontalAlignment="Right" Height="21" Margin="0,30,1080,0" VerticalAlignment="Top" Width="100" Click="ButtonOpenIgnoreFile_Click" />
                    <Label x:Name="LabelShown" VerticalContentAlignment="Top" Grid.Row="2" Content="Shown 0" HorizontalAlignment="Left" Height="24" Margin="0,8,1140,0" VerticalAlignment="Top" Width="76" />
                    <Label x:Name="LabelTotal" VerticalContentAlignment="Top" Grid.Row="2" Content="Total 0" HorizontalAlignment="Left" Height="24" Margin="0,30,1140,0" VerticalAlignment="Top" Width="76" />
                </Grid>
            </TabItem>
            <TabItem Header="Non RegistryKey Commands">
                <DataGrid x:Name="DataGridNonRegCommands" RowHeaderWidth="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UID" Width="40" Binding="{Binding ListId}" />
                        <DataGridTextColumn Header="List Line String" Width="*" Binding="{Binding ListLineString}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

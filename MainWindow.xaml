<Window x:Class="RegistryKey_Check.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        Title="RegistryKey Check" MinHeight="700" MinWidth="1300" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <local:BlankNullConverter x:Key="BlankNull" />
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="RegistryKey Commands">
                <Grid PreviewMouseLeftButtonDown="RegCommandsGrid_PreviewMouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="StackPanelFilters" Height="26" Orientation="Horizontal" Margin="1,0,0,0">
                        <TextBox x:Name="TextBoxFilterUID" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegUID, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegUID, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterListCommand" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegListCommand, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegListCommand, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterFullPath" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegFullPath, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegFullPath, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterAvailableSubKey" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegAvailableSubKey, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegAvailableSubKey, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterListValueName" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegListValueName, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegListValueName, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterAvailableValueName" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegAvailableValueName, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegAvailableValueName, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterListValueType" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegListValueType, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegListValueType, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterRegEditValueType" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegRegEditValueType, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegRegEditValueType, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterListValueData" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegListValueData, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegListValueData, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterRegEditValueData" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegRegEditValueData, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegRegEditValueData, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterExecuteResult" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegExecuteResult, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegExecuteResult, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterListMatchWithRegEdit" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegListMatchWithRegEdit, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegListMatchWithRegEdit, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                        <TextBox x:Name="TextBoxFilterComplianceDetails" Height="26" VerticalContentAlignment="Center" Width="{Binding ActualWidth, ElementName=dgColumnRegComplianceDetails, Mode=OneWay}" Visibility="{Binding Visibility, ElementName=dgColumnRegComplianceDetails, Mode=OneWay}" TextChanged="TextBoxFilter_TextChanged" />
                    </StackPanel>
                    <DataGrid x:Name="DataGridRegCommands" RowHeaderWidth="0" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ColumnReordered="DataGridRegCommands_ColumnReordered">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Jump to RegEdit" Click="MenuJumpToRegEdit_Click" />
                                <Separator />
                                <MenuItem Header="Add to Ignore List" Click="MenuAddToIgnoreList_Click" />
                                <MenuItem Header="Remove from Ignore List" Click="MenuRemoveFromIgnoreList_Click" />
                            </ContextMenu>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#706060FF" />
                                        <Setter Property="Foreground" Value="#FF000000" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Value="False" Binding="{Binding ListMatchWithRegEdit}">
                                        <Setter Property="Background" Value="#FFD05050" />
                                    </DataTrigger>
                                    <DataTrigger Value="True" Binding="{Binding ListMatchWithRegEdit}">
                                        <Setter Property="Background" Value="#FF50D050" />
                                    </DataTrigger>
                                    <DataTrigger Value="Ignored" Binding="{Binding ListMatchWithRegEdit}">
                                        <Setter Property="Background" Value="#FFC8C8C8" />
                                    </DataTrigger>
                                    <DataTrigger Value="True" Binding="{Binding HasListWarning}">
                                        <Setter Property="Background" Value="#FFF0D040" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRegCommands_Row_MouseDoubleClick" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRegCommands_Row_PreviewMouseRightButtonDown" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="dgColumnRegUID" Header="UID" Width="40" Binding="{Binding ListId}" />
                            <DataGridTextColumn x:Name="dgColumnRegListCommand" Header="List Command" Width="95" Binding="{Binding ListCommand}" />
                            <DataGridTextColumn x:Name="dgColumnRegFullPath" Header="Full Path" Width="315*" Binding="{Binding ListFullPath, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableSubKey" Header="SubKey Available?" Width="115" Visibility="Collapsed" Binding="{Binding AvailableSubKey}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueName" Header="List Value Name" Width="130*" Binding="{Binding ListValueName, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableValueName" Header="Value Name Available?" Width="140" Visibility="Collapsed" Binding="{Binding AvailableValueName, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueType" Header="List Value Type" Width="100" Binding="{Binding ListValueType, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueType" Header="RegEdit Value Type" Width="120" Binding="{Binding RegEditValueType, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueData" Header="List Value Data" Width="125*" Binding="{Binding ListValueData, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueData" Header="RegEdit Value Data" Width="125*" Binding="{Binding RegEditValueData, Converter={StaticResource BlankNull}}" />
                            <DataGridTextColumn x:Name="dgColumnRegExecuteResult" Header="Execute Result" Width="95" Visibility="Collapsed" Binding="{Binding ExecuteResult}" />
                            <DataGridTextColumn x:Name="dgColumnRegListMatchWithRegEdit" Header="List Match with RegEdit" Width="145" Visibility="Collapsed" Binding="{Binding ListMatchWithRegEdit}" />
                            <DataGridTextColumn x:Name="dgColumnRegComplianceDetails" Header="Compliance Details" Width="210*" Binding="{Binding ComplianceDetails, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="ButtonReadListFile" Grid.Row="2" Content="Read List.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,10,0" VerticalAlignment="Top" Width="160" Click="ButtonReadListFile_Click" />
                    <Button x:Name="ButtonQueryFromRegEdit" Grid.Row="2" Content="Query RegEdit" HorizontalAlignment="Right" Height="40" Margin="0,10,180,0" VerticalAlignment="Top" Width="160" Click="ButtonQueryFromRegEdit_Click" />
                    <Button x:Name="ButtonExecuteMissingCommands" Background="#FFFFA500" Grid.Row="2" Content="Execute Missing Commands" HorizontalAlignment="Right" Height="40" Margin="0,10,350,0" VerticalAlignment="Top" Width="160" Click="ButtonExecuteMissingCommands_Click" />
                    <Button x:Name="ButtonOpenListFile" Grid.Row="2" Content="Open List.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,520,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenListFile_Click" />
                    <Button x:Name="ButtonOpenLogFile" Grid.Row="2" Content="Open Log.txt" HorizontalAlignment="Right" Height="40" Margin="0,10,690,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenLogFile_Click" />
                    <Button x:Name="ButtonFilterFalses" VerticalContentAlignment="Top" Grid.Row="2" Content="Apply False Filter" HorizontalAlignment="Right" Height="21" Margin="0,8,860,0" VerticalAlignment="Top" Width="100" Click="ButtonFilterFalses_Click" />
                    <Button x:Name="ButtonFilterTrues" VerticalContentAlignment="Top" Grid.Row="2" Content="Apply True Filter" HorizontalAlignment="Right" Height="21" Margin="0,30,860,0" VerticalAlignment="Top" Width="100" Click="ButtonFilterTrues_Click" />
                    <Button x:Name="ButtonAllFiltersReset" VerticalContentAlignment="Top" Grid.Row="2" Content="All Filters Reset" HorizontalAlignment="Right" Height="21" Margin="0,8,970,0" VerticalAlignment="Top" Width="100" Click="ButtonAllFiltersReset_Click" />
                    <Button x:Name="ButtonColumns" VerticalContentAlignment="Top" Grid.Row="2" Content="Columns" HorizontalAlignment="Right" Height="21" Margin="0,8,1080,0" VerticalAlignment="Top" Width="100" Click="ButtonColumns_Click" />
                    <Button x:Name="ButtonOpenIgnoreFile" VerticalContentAlignment="Top" Grid.Row="2" Content="Open Ignore.txt" HorizontalAlignment="Right" Height="21" Margin="0,30,1080,0" VerticalAlignment="Top" Width="100" Click="ButtonOpenIgnoreFile_Click" />
                    <Button x:Name="ButtonHelp" VerticalContentAlignment="Top" Grid.Row="2" Content="Help" HorizontalAlignment="Right" Height="21" Margin="0,30,970,0" VerticalAlignment="Top" Width="100" Click="ButtonHelp_Click" />
                    <Label x:Name="LabelShown" VerticalContentAlignment="Top" Grid.Row="2" Content="Shown 0" HorizontalAlignment="Left" Height="24" Margin="0,8,1140,0" VerticalAlignment="Top" Width="76" />
                    <Label x:Name="LabelTotal" VerticalContentAlignment="Top" Grid.Row="2" Content="Total 0" HorizontalAlignment="Left" Height="24" Margin="0,30,1140,0" VerticalAlignment="Top" Width="76" />
                </Grid>
            </TabItem>
            <TabItem Header="Non RegistryKey Commands">
                <DataGrid x:Name="DataGridNonRegCommands" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UID" Width="40" Binding="{Binding ListId}" />
                        <DataGridTextColumn Header="List Line String" Width="*" Binding="{Binding ListLineString}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

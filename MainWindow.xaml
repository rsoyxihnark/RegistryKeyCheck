<Window x:Class="RegistryKey_Check.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistryKey_Check"
        mc:Ignorable="d"
        Title="RegistryKey Check" MinHeight="600" MinWidth="1280" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" FocusManager.FocusedElement="{Binding ElementName=TextBoxFind}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" CanExecute="Find_CanExecute" Executed="Find_Executed" />
    </Window.CommandBindings>
    <Grid>
        <TabControl>
            <TabItem x:Name="TabItemRegCommands" Header="RegistryKey Commands">
                <Grid PreviewMouseLeftButtonDown="RegCommandsGrid_PreviewMouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PanelFind" Orientation="Horizontal" Margin="2,4,0,6">
                        <TextBox x:Name="TextBoxFind" Style="{StaticResource FindBox}" Width="340" Height="28" TextChanged="TextBoxFind_TextChanged" PreviewKeyDown="TextBoxFind_PreviewKeyDown" />
                    </StackPanel>
                    <DataGrid x:Name="DataGridRegCommands" RowHeaderWidth="0" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowMenu">
                                <MenuItem Header="Jump to RegEdit" Click="MenuJumpToRegEdit_Click" />
                                <Separator />
                                <MenuItem Header="Add to Ignore List" Click="MenuAddToIgnoreList_Click" />
                                <MenuItem Header="Remove from Ignore List" Click="MenuRemoveFromIgnoreList_Click" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRegCommands_Row_MouseDoubleClick" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRegCommands_Row_PreviewMouseRightButtonDown" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="dgColumnRegUID" Header="UID" Width="40" Binding="{Binding ListId}" />
                            <DataGridTextColumn x:Name="dgColumnRegListCommand" Header="List Command" Width="95" Visibility="Collapsed" Binding="{Binding ListCommand}" />
                            <DataGridTextColumn x:Name="dgColumnRegFullPath" Header="Path" Width="315*" Binding="{Binding ListFullPath, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableSubKey" Header="SubKey Available?" Width="115" Visibility="Collapsed" Binding="{Binding AvailableSubKey}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueName" Header="Value" Width="130*" Binding="{Binding ListValueNameShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegAvailableValueName" Header="Value Name Available?" Width="140" Visibility="Collapsed" Binding="{Binding AvailableValueNameShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueType" Header="List Value Type" Width="100" Visibility="Collapsed" Binding="{Binding ListValueTypeShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueType" Header="Registry Value Type" Width="125" Visibility="Collapsed" Binding="{Binding RegEditValueTypeShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegListValueData" Header="Expected" Width="125*" Binding="{Binding ListValueDataShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegRegEditValueData" Header="Actual" Width="125*" Binding="{Binding RegEditValueDataShown, Mode=OneWay}" />
                            <DataGridTextColumn x:Name="dgColumnRegExecuteResult" Header="Execute Result" Width="95" Visibility="Collapsed" Binding="{Binding ExecuteResult}" />
                            <DataGridTextColumn x:Name="dgColumnRegListMatchWithRegEdit" Header="List Match with Registry" Width="150" Visibility="Collapsed" Binding="{Binding ListMatchWithRegEdit}" />
                            <DataGridTextColumn x:Name="dgColumnRegComplianceDetails" Header="Details" Width="210*" Binding="{Binding ComplianceDetails, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding ListMatchWithRegEdit}">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="False" Binding="{Binding ListMatchWithRegEdit}">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True" Binding="{Binding HasListWarning}">
                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="PanelEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=DataGridRegCommands}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="52" Height="52" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <Ellipse x:Name="EmptyRing" StrokeThickness="1.5">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterFalses}" Value="True" />
                                                    <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterTrues}" Value="False" />
                                                    <Condition Binding="{Binding Text, ElementName=TextBoxFind}" Value="" />
                                                    <Condition Binding="{Binding Text, ElementName=TextNonCompliant}" Value="0 noncompliant" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Stroke" Value="{StaticResource GreenBrush}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=TextLines}" Value="0 lines">
                                                <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Path x:Name="EmptyGlyph" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource SearchGlyph}" />
                                        <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterFalses}" Value="True" />
                                                    <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterTrues}" Value="False" />
                                                    <Condition Binding="{Binding Text, ElementName=TextBoxFind}" Value="" />
                                                    <Condition Binding="{Binding Text, ElementName=TextNonCompliant}" Value="0 noncompliant" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Data" Value="{StaticResource CheckGlyph}" />
                                                <Setter Property="Stroke" Value="{StaticResource GreenBrush}" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=TextLines}" Value="0 lines">
                                                <Setter Property="Data" Value="{StaticResource ListGlyph}" />
                                                <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="TextEmpty" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No rows to show" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterFalses}" Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=ButtonFilterTrues}" Value="False" />
                                                <Condition Binding="{Binding Text, ElementName=TextBoxFind}" Value="" />
                                                <Condition Binding="{Binding Text, ElementName=TextNonCompliant}" Value="0 noncompliant" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="No noncompliant lines" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=TextLines}" Value="0 lines">
                                            <Setter Property="Text" Value="No rows to show" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="TextEmptyHint" FontSize="12" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="All Filters Reset shows every row" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TextLines}" Value="0 lines">
                                            <Setter Property="Text" Value="Write reg lines into List.txt, then press Read List.txt" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border x:Name="BusyBar" Grid.Row="2" Height="2" Margin="1,2,1,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform>
                                    <TranslateTransform X="-1" />
                                </LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#004A8CF7" Offset="0.3" />
                                <GradientStop Color="#FF4A8CF7" Offset="0.5" />
                                <GradientStop Color="#004A8CF7" Offset="0.7" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=ButtonQueryFromRegEdit}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="BusyRun">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-0.7" To="0.7" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="BusyRun" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button x:Name="ButtonReadListFile" Grid.Row="2" Content="Read List.txt" HorizontalAlignment="Right" Height="43" Margin="0,8,10,0" VerticalAlignment="Top" Width="160" Click="ButtonReadListFile_Click" />
                    <Button x:Name="ButtonQueryFromRegEdit" Grid.Row="2" Content="Query Registry" HorizontalAlignment="Right" Height="43" Margin="0,8,176,0" VerticalAlignment="Top" Width="160" Click="ButtonQueryFromRegEdit_Click" />
                    <Button x:Name="ButtonExecuteMissingCommands" Style="{StaticResource ExecuteButton}" Grid.Row="2" Content="Execute Missing Commands" HorizontalAlignment="Right" Height="43" Margin="0,8,342,0" VerticalAlignment="Top" Width="160" Click="ButtonExecuteMissingCommands_Click" />
                    <Button x:Name="ButtonOpenListFile" Grid.Row="2" Content="Open List.txt" HorizontalAlignment="Right" Height="43" Margin="0,8,508,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenListFile_Click" />
                    <Button x:Name="ButtonOpenLogFile" Grid.Row="2" Content="Open Log.txt" HorizontalAlignment="Right" Height="43" Margin="0,8,674,0" VerticalAlignment="Top" Width="160" Click="ButtonOpenLogFile_Click" />
                    <ToggleButton x:Name="ButtonFilterFalses" Style="{StaticResource FilterToggle}" Tag="{StaticResource RedBrush}" VerticalContentAlignment="Top" Grid.Row="2" Content="Non-Compliant" HorizontalAlignment="Right" Height="21" Margin="0,8,840,0" VerticalAlignment="Top" Width="100" Checked="FilterButton_Changed" Unchecked="FilterButton_Changed" />
                    <ToggleButton x:Name="ButtonFilterTrues" Style="{StaticResource FilterToggle}" Tag="{StaticResource GreenBrush}" VerticalContentAlignment="Top" Grid.Row="2" Content="Compliant" HorizontalAlignment="Right" Height="21" Margin="0,30,840,0" VerticalAlignment="Top" Width="100" Checked="FilterButton_Changed" Unchecked="FilterButton_Changed" />
                    <Button x:Name="ButtonAllFiltersReset" Grid.Row="2" Content="All Filters Reset" HorizontalAlignment="Right" Height="43" Margin="0,8,946,0" VerticalAlignment="Top" Width="100" Click="ButtonAllFiltersReset_Click" />
                    <Button x:Name="ButtonColumns" VerticalContentAlignment="Top" Grid.Row="2" Content="Columns" HorizontalAlignment="Right" Height="21" Margin="0,8,1052,0" VerticalAlignment="Top" Width="100" Click="ButtonColumns_Click" />
                    <Button x:Name="ButtonOpenIgnoreFile" VerticalContentAlignment="Top" Grid.Row="2" Content="Open Ignore.txt" HorizontalAlignment="Right" Height="21" Margin="0,30,1052,0" VerticalAlignment="Top" Width="100" Click="ButtonOpenIgnoreFile_Click" />
                    <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,7,0,0">
                        <TextBlock x:Name="TextLines" Text="0 lines" FontSize="11" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="TextCompliant" Text="0 compliant" FontSize="11" Foreground="{StaticResource GreenBrush}" />
                        <TextBlock x:Name="TextNonCompliant" Text="0 noncompliant" FontSize="11" Foreground="{StaticResource RedBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Non RegistryKey Commands">
                <DataGrid x:Name="DataGridNonRegCommands" RowHeaderWidth="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UID" Width="40" Binding="{Binding ListId}" />
                        <DataGridTextColumn Header="List Line String" Width="*" Binding="{Binding ListLineString}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
